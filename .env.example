# Copy this file to `.env` and fill in your key.
# Get a FREE Groq API key: https://console.groq.com/keys  (keys start with gsk_)
GROQ_API_KEY=your-free-groq-key-here

# Optional — override the model (default: openai/gpt-oss-120b).
# Note: this project uses STRUCTURED output, which the code requests via Groq's
# native mode (method="json_schema" in panel.py). Keep that if you swap models.
# GROQ_MODEL=openai/gpt-oss-120b

# Request and provider safeguards (bounded again by application limits).
MAX_PITCH_CHARS=4000
PITCH_RATE_LIMIT_REQUESTS=3
PITCH_RATE_LIMIT_WINDOW_SECONDS=600
MAX_CONCURRENT_PANEL_RUNS=1
# In-process app-side preflight ceilings; Groq account limits remain authoritative.
# Groq account-level limits: 10 RPM, 500 RPD, 8K TPM, and 100K TPD.
# Local counters reset on process restart and do not coordinate across replicas.
APP_GROQ_REQUESTS_PER_MINUTE=10
APP_GROQ_REQUESTS_PER_DAY=500
MAX_PANEL_DURATION_SECONDS=240
GROQ_REQUEST_TIMEOUT_SECONDS=45
# Automatic Groq retries are disabled so a panel cannot exceed its 7-call budget.
# Output is capped at 5000 tokens per call (3,5000 generated tokens per panel).
GROQ_MAX_OUTPUT_TOKENS=5000
